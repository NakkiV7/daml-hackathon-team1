# Secrets. .env IS committed here on purpose: this repo is private and the
# DevNet credential is a shared hackathon secret the whole team already has, so
# the alternative was every teammate being unable to start the demo. Do not copy
# this pattern into anything real.
.env.local
.env.*.local
devnet.env

# Node / frontend
node_modules/
dist/
build/
.next/
.vite/

# Daml
proj/.daml/
proj/log/

# OS
.DS_Store

# Python build artifacts
__pycache__/
*.pyc
.pytest_cache/
