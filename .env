C8_BASE=https://api.validator.dev.digik.cantor8.tech/api/ledger
C8_IDP=https://auth.dev.digik.cantor8.tech
C8_CLIENT_ID=hackathon
C8_CLIENT_SECRET=0JElLeAZK7fcRF4ngghM2s7XWxPgDYSD

# The Keycloak client-credentials token's subject. c8lab defaults to
# `ledger-api-user`, which only exists on LocalNet; on DevNet that makes every
# act-as grant 404 and every submit fail with "a security-sensitive error".
C8_USER=validator-backend@clients
C8_REGISTRY=https://sv-proxy.dev.digik.cantor8.tech

# Amulet's issuer (the DSO). c8lab discovers this by scanning /v2/parties, but
# that endpoint is paginated on DevNet and the DSO is not on page one, so the
# lookup fails with a misleading "could not find the DSO party". Set it directly.
C8_ADMIN_PARTY=DSO::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a
