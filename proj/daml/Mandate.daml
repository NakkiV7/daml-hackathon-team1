-- Starter for the mandate task (D3 direct debit / D4 agent wallet).
--
-- One party lets another spend up to a cap, until a deadline, and can revoke
-- at any time. Same contract either way: for D3 the spender is a merchant,
-- for D4 it is an AI agent.
--
-- The point of the task: the cap is enforced HERE, in Daml. Not in your API.
-- A cap checked in Python is a suggestion. A cap in a choice body is a rule.
--
-- What to build on top:
--   * move real value: make Charge exercise a token transfer, not just record it
--   * an allow-list of counterparties the spender may pay
--   * per-period reset (harder than it looks, do the total cap first)
--   * an audit view of every charge
module Mandate where

import DA.Time


template Mandate
  with
    owner    : Party      -- who is paying
    spender  : Party      -- merchant, or agent
    cap      : Decimal    -- total they may spend over the mandate's life
    spent    : Decimal    -- how much so far
    expiresAt : Time
    -- Per-period limit: at most periodCap per periodLength, on top of the
    -- lifetime cap. Nothing runs on a timer in Daml, so the period cannot
    -- reset itself when time passes: Charge rolls the window forward lazily,
    -- anchored to periodStart. A "month" here is a fixed periodLength (e.g.
    -- days 30), not a calendar month.
    periodCap    : Decimal
    periodSpent  : Decimal  -- spent within the current window
    periodStart  : Time     -- start of the current window
    periodLength : RelTime
  where
    ensure cap > 0.0 && spent >= 0.0 && spent <= cap
      && periodCap > 0.0 && periodSpent >= 0.0 && periodSpent <= periodCap
      && convertRelTimeToMicroseconds periodLength > 0

    -- Both must agree it exists. The owner cannot be signed up without
    -- consenting, and the spender cannot be bound without consenting.
    signatory owner, spender

    -- Spend within the mandate. No owner signature needed, that is the point.
    choice Charge : ContractId Mandate
      with amount : Decimal
      controller spender
      do
        now <- getTime
        -- Deadlines are NOT enforced for you. Check them yourself.
        assertMsg "mandate expired" (now < expiresAt)
        assertMsg "amount must be positive" (amount > 0.0)
        -- Roll the window forward before checking the period cap. Advance by
        -- WHOLE periods from periodStart, never to `now`: anchoring to `now`
        -- would let the spender slide the window by timing their charges.
        -- A gap of several quiet periods must advance several periods at once.
        let plen = convertRelTimeToMicroseconds periodLength
            elapsed = convertRelTimeToMicroseconds (subTime now periodStart)
            wholePeriods = elapsed / plen   -- Int `/` truncates in Daml, on purpose
            rolledOver = wholePeriods >= 1
            curStart = if rolledOver
                       then addRelTime periodStart (convertMicrosecondsToRelTime (wholePeriods * plen))
                       else periodStart
            curPeriodSpent = if rolledOver then 0.0 else periodSpent
        assertMsg "charge would exceed the period cap" (curPeriodSpent + amount <= periodCap)
        assertMsg "charge would exceed the cap" (spent + amount <= cap)
        newMandateCid <- create this with
          spent = spent + amount
          periodSpent = curPeriodSpent + amount
          periodStart = curStart
        create MandateChargeAudit with
          owner
          spender
          amount
          newSpent = spent + amount
          at = now
          rule = (if rolledOver then "period rolled over; " else "")
                 <> "period-cap + total-cap check"
        pure newMandateCid

    -- The owner can always stop it, and the spender cannot block that.
    choice Revoke : ()
      controller owner
      do
        now <- getTime
        create MandateRevokeAudit with
          owner
          spender
          at = now
          reason = "owner revocation"
        pure ()

    -- Raising the cap needs both parties, because both are signatories.
    choice Adjust : ContractId Mandate
      with newCap : Decimal
      controller owner, spender
      do
        assertMsg "new cap below what is already spent" (newCap >= spent)
        create this with cap = newCap


template MandateChargeAudit
  with
    owner    : Party
    spender  : Party
    amount   : Decimal
    newSpent : Decimal
    at       : Time
    rule     : Text
  where
    signatory spender
    observer owner


template MandateRevokeAudit
  with
    owner  : Party
    spender: Party
    at     : Time
    reason : Text
  where
    signatory owner
    observer spender


-- Propose and accept: the most common shape in Daml.
-- You cannot force a contract on someone who has to sign it, and you are
-- rarely online at the same time. So you offer, and they accept later.
template MandateProposal
  with
    owner    : Party
    spender  : Party
    cap      : Decimal
    expiresAt : Time
    periodCap    : Decimal
    periodLength : RelTime
  where
    signatory owner
    observer spender

    choice Accept : ContractId Mandate
      controller spender
      do
        -- The first period starts when the spender accepts, not when the
        -- owner proposed: the spender should get a full window.
        now <- getTime
        create Mandate with
          owner; spender; cap; spent = 0.0; expiresAt
          periodCap; periodLength
          periodSpent = 0.0
          periodStart = now

    choice Reject : ()
      controller spender
      do pure ()