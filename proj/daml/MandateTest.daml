module MandateTest where

import DA.Time (addRelTime, days)
import Daml.Script
import Mandate


-- Proves revocation is enforced by the ledger rather than by an API:
--   * the agent can charge while the mandate is active;
--   * the agent cannot revoke (or otherwise interfere with revocation);
--   * the owner revokes without the agent's authorization; and
--   * the agent cannot charge the replacement mandate marked as revoked.
revocationTest : Script ()
revocationTest = script do
  owner <- allocateParty "Owner"
  agent <- allocateParty "Agent"
  merchant <- allocateParty "Merchant"
  now <- getTime

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      spender = agent
      cap = 100.0
      counterparties = [merchant]
      expiresAt = addRelTime now (days 1)
      periodCap = 100.0
      periodLength = days 30

  mandateCid <- submit agent do
    exerciseCmd proposalCid Accept

  -- Establish that this contract id really is usable by the agent.
  activeMandateCid <- submit agent do
    exerciseCmd mandateCid Charge with amount = 10.0; payee = merchant

  -- Revoke is controlled only by the owner.
  submitMustFail agent do
    exerciseCmd activeMandateCid Revoke

  -- No agent authorization is present in this submission. Revoke consumes the
  -- active contract and returns its replacement with revoked = True.
  revokedMandateCid <- submit owner do
    exerciseCmd activeMandateCid Revoke

  -- Exercise the NEW contract id so this proves the Daml `not revoked` guard,
  -- rather than merely proving that the previous contract id was consumed.
  submitMustFail agent do
    exerciseCmd revokedMandateCid Charge with amount = 1.0; payee = merchant
